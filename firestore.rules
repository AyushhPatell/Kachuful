rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /sessions/{sessionCode} {
      allow read, write: if request.auth != null;

      match /players/{playerId} {
        allow read, write: if request.auth != null;
      }

      match /rounds/{roundId} {
        allow read, write: if request.auth != null;
      }

      match /joinRequests/{requestId} {
        allow read, write: if request.auth != null;
      }
    }

    // Session history. Any authenticated player can read/write any entry —
    // the game engine writes every participant's summary at session end, and
    // the storage-cleanup sweep needs to check whether a session has scrolled
    // out of every participant's recent-history view before deleting it.
    match /userHistory/{userId}/sessions/{sessionCode} {
      allow read, write: if request.auth != null;
    }

    // An account is an admin if its verified email is the bootstrap owner OR it
    // has a doc under /admins. Bootstrap the very first /admins doc from the
    // Firebase console (console writes bypass these rules).
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'aspatel11410@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Admin allowlist. A user may read only their OWN doc (to check their own
    // status) — non-admins can't enumerate the collection, so admin identities
    // stay hidden. Admins can read any doc (to manage the list) and grant/revoke.
    match /admins/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // Global broadcast (reload prompts / announcements). Everyone reads; admins write.
    match /system/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
